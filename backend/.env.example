# Neon pooled connection string (required — app refuses to start without it)
DATABASE_URL=

# Resend transactional email
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# Shared secret for the admin endpoints (GET /api/enrollments, PATCH .../verify).
# Sent by the admin dashboard as the X-Admin-Key header.
ADMIN_KEY=

# Address that receives a heads-up whenever a new enrollment comes in.
# Empty -> the notification is skipped.
ACADEMY_NOTIFICATION_EMAIL=

# Paid-students WhatsApp group links, added to the payment confirmation email.
# The confirmation email picks the link for the student's programme_key
# (uiux / data / swe), falling back to PAID_STUDENTS_WHATSAPP_LINK. If none of
# the relevant ones are set, the link line is omitted.
PAID_STUDENTS_WHATSAPP_LINK=
WHATSAPP_LINK_UIUX=
WHATSAPP_LINK_DATA=
WHATSAPP_LINK_SWE=
